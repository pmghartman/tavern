{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern",
  "version": "0.6.0",
  "identifier": "io.github.pmghartman.tavern",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tavern",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 520,
        "url": "index.html",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "D&D 5e with an AI dungeon master",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
